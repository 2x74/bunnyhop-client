// First executable icon: the existing official multi-resolution repository ICO.
1 ICON "@BUNNYHOP_WINDOWS_ICON@"

// What Windows shows under Properties > Details. Numeric values, so no SDK header is needed:
// 0x40004 is VOS_NT_WINDOWS32 and file type 1 is an application.
1 VERSIONINFO
FILEVERSION @BUNNYHOP_RC_VERSION@
PRODUCTVERSION @BUNNYHOP_RC_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "bunnyhop.lol"
            VALUE "FileDescription", "bunnyhop.lol - Native"
            VALUE "FileVersion", "@BUNNYHOP_PACKAGE_VERSION@"
            VALUE "InternalName", "bunnyhop-native"
            VALUE "LegalCopyright", "Copyright (c) 2026 Aeperion. MIT License."
            VALUE "OriginalFilename", "bunnyhop-native.exe"
            VALUE "ProductName", "bunnyhop.lol - Native"
            VALUE "ProductVersion", "@BUNNYHOP_PACKAGE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
