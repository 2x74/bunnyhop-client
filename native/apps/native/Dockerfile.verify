# Official Rust + Debian, pinned to the image used for Linux/aarch64 verification.
FROM rust:slim@sha256:4df2ae8cfdfebdfc13a65da7f253b73d68983dc0339f2719bc17a279c913b13d
ARG WITH_CLIENT=0
RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake ninja-build g++ pkg-config ca-certificates libcurl4-openssl-dev \
    && if [ "$WITH_CLIENT" = 1 ]; then \
      apt-get install -y --no-install-recommends libsdl3-dev libgl1-mesa-dev libpango1.0-dev fonts-dejavu-core fonts-noto-core \
        xvfb xauth mesa-utils; \
    fi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
