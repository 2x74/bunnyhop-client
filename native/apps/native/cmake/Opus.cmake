# libopus from vendor/opus (voice chat). The float build in plain C: no SIMD or runtime CPU detection, no DNN
# features, so every platform compiles the same files. The source lists come from the upstream .mk files.
enable_language(C)
set(OPUS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/vendor/opus")
function(bunnyhop_opus_sources out)
    set(files)
    foreach(mk opus celt silk)
        file(READ "${OPUS_DIR}/${mk}_sources.mk" text)
        string(REPLACE "\\\n" " " text "${text}")
        string(REGEX MATCHALL "[A-Z_]+ = [^\n]*" lists "${text}")
        foreach(entry IN LISTS lists)
            string(REGEX MATCH "^([A-Z_]+) = (.*)$" _ "${entry}")
            if(CMAKE_MATCH_1 IN_LIST ARGN)
                separate_arguments(names UNIX_COMMAND "${CMAKE_MATCH_2}")
                foreach(name IN LISTS names)
                    list(APPEND files "${OPUS_DIR}/${name}")
                endforeach()
            endif()
        endforeach()
    endforeach()
    set(${out} ${files} PARENT_SCOPE)
endfunction()
bunnyhop_opus_sources(OPUS_C_SOURCES OPUS_SOURCES OPUS_SOURCES_FLOAT CELT_SOURCES SILK_SOURCES SILK_SOURCES_FLOAT)
add_library(bunnyhop_opus STATIC ${OPUS_C_SOURCES})
target_include_directories(bunnyhop_opus PUBLIC "${OPUS_DIR}/include")
target_include_directories(bunnyhop_opus PRIVATE "${OPUS_DIR}" "${OPUS_DIR}/celt" "${OPUS_DIR}/silk" "${OPUS_DIR}/silk/float")
# alloca rather than C99 variable-length arrays, which MSVC lacks.
target_compile_definitions(bunnyhop_opus PRIVATE OPUS_BUILD USE_ALLOCA)
if(MSVC)
    target_compile_options(bunnyhop_opus PRIVATE /W0)
else()
    target_compile_options(bunnyhop_opus PRIVATE -w)
    target_compile_definitions(bunnyhop_opus PRIVATE HAVE_LRINTF)
    if(UNIX AND NOT APPLE)
        target_link_libraries(bunnyhop_opus PRIVATE m)
    endif()
endif()
set_target_properties(bunnyhop_opus PROPERTIES C_STANDARD 99 POSITION_INDEPENDENT_CODE ON)
