new file mode 100644
index 0000000..85be589
--- /dev/null
+++ b/apps/web/src/native-input.ts
@@ -0,0 +1,75 @@
+/** Narrow Electron preload contract. Native report times are monotonic epoch milliseconds. */
+export interface NativeInputStatus {
+  captured: boolean;
+  raw: boolean;
+  backend: string;
+  error?: string;
+}
+export interface NativeMotionSample { dx: number; dy: number; time: number }
+export interface NativeInputBridge {
+  capture(enabled: boolean): Promise<NativeInputStatus>;
+  drain(): NativeMotionSample[];
+  status?(): NativeInputStatus;
+}
+declare global {
+  interface Window { bunnyhopNativeInput?: NativeInputBridge }
+}
+
+/** Owns native capture lifetime independently of DOM lock events and stale IPC replies. */
+export class NativeMouse {
+  active = false;
+  pending = false;
+  backend = "";
+  error = "";
+  private epoch = 0;
+  private checkedAt = 0;
+  constructor(private readonly bridge: NativeInputBridge | undefined) {}
+
+  async start(): Promise<boolean> {
+    if (!this.bridge) return false;
+    const epoch = ++this.epoch;
+    this.pending = true;
+    this.active = false;
+    try {
+      const status = await this.bridge.capture(true);
+      if (epoch !== this.epoch) return false;
+      this.backend = status.backend;
+      this.error = status.error ?? "";
+      this.active = status.captured && status.raw;
+      if (status.captured && !status.raw) void this.bridge.capture(false).catch(() => {});
+      this.checkedAt = 0;
+      return this.active;
+    } catch (e) {
+      if (epoch === this.epoch) this.error = e instanceof Error ? e.message : String(e);
+      return false;
+    } finally {
+      if (epoch === this.epoch) this.pending = false;
+    }
+  }
+
+  stop(): void {
+    ++this.epoch;
+    this.active = this.pending = false;
+    if (this.bridge) void this.bridge.capture(false).catch(() => {});
+  }
+
+  drain(now: number): NativeMotionSample[] {
+    if (!this.bridge || !this.active) return [];
+    try {
+      if (this.bridge.status && now - this.checkedAt >= 250) {
+        this.checkedAt = now;
+        const status = this.bridge.status();
+        if (!(status.captured && status.raw)) {
+          this.error = status.error ?? "Native capture was released";
+          this.stop();
+          return [];
+        }
+      }
+      return this.bridge.drain();
+    } catch (e) {
+      this.error = e instanceof Error ? e.message : String(e);
+      this.stop();
+      return [];
+    }
+  }
+}
diff --git a/apps/web/src/native-runtime.ts b/apps/web/src/native-runtime.ts
new file mode 100644
index 0000000..d8c4428
--- /dev/null
+++ b/apps/web/src/native-runtime.ts
@@ -0,0 +1,40 @@
+// Optional desktop transport. No DOM or Node dependency: server/worker simulations stay WASM.
+export interface NativeSession {
+  exports: string[];
+  call(name: string, args: number[]): number;
+  read(pointer: number, length: number): Uint8Array;
+  write(pointer: number, bytes: Uint8Array): void;
+  dispose(): void;
+}
+export interface NativeRuntime {
+  build: string;
+  compatibleWasm: string;
+  platform: string;
+  createSession(): NativeSession;
+}
+export function nativeRuntime(): NativeRuntime | undefined {
+  return (globalThis as typeof globalThis & { bunnyhopNative?: NativeRuntime }).bunnyhopNative;
+}
+
+interface MemoryTransport {
+  memory: { buffer: ArrayBufferLike };
+  nativeRead?: NativeSession["read"];
+  nativeWrite?: NativeSession["write"];
+}
+export function coreBytes(x: MemoryTransport, ptr: number, length: number): Uint8Array {
+  return x.nativeRead ? new Uint8Array(x.nativeRead(ptr, length)) : new Uint8Array(x.memory.buffer, ptr, length);
+}
+export function coreWrite(x: MemoryTransport, ptr: number, bytes: Uint8Array): void {
+  if (x.nativeWrite) x.nativeWrite(ptr, bytes);
+  else new Uint8Array(x.memory.buffer, ptr, bytes.length).set(bytes);
+}
+export function coreF32(x: MemoryTransport, ptr: number, length: number): Float32Array {
+  if (!x.nativeRead) return new Float32Array(x.memory.buffer, ptr, length);
+  const bytes = coreBytes(x, ptr, length * 4);
+  return new Float32Array(bytes.buffer, bytes.byteOffset, length);
+}
+export function coreU32(x: MemoryTransport, ptr: number, length: number): Uint32Array {
+  if (!x.nativeRead) return new Uint32Array(x.memory.buffer, ptr, length);
+  const bytes = coreBytes(x, ptr, length * 4);
+  return new Uint32Array(bytes.buffer, bytes.byteOffset, length);
+}
