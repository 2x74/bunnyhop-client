--- /dev/null
+++ b/crates/core/tests/native_entities.rs
@@ -0,0 +1,33 @@
+use bunnyhop_core::{Cmd, Game};
+use std::path::PathBuf;
+
+fn load(name: &str) -> Option<Game> {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../maps").join(format!("{name}.bsp"));
+    let bytes = std::fs::read(&path).map_err(|_| eprintln!("skipping {name}: {} not found", path.display())).ok()?;
+    Some(Game::load(&bunnyhop_core::parse_bsp(&bytes).unwrap()).unwrap())
+}
+
+/// Synthetic uses a solid brush with $surfaceprop ladder rather than CONTENTS_LADDER.
+#[test]
+fn synthetic_material_ladder_is_versioned() {
+    use bunnyhop_core::{Settings, game::{PHYSICS_V17, PHYSICS_V18}};
+    let Some(mut game) = load("bhop_synthetic_fix") else { return };
+    for version in [PHYSICS_V17, PHYSICS_V18] {
+        game.set_settings(Settings { physics_version: version, ..Settings::css_bhop() });
+        game.reset();
+        game.place_player([-12052.5, 13065.0, 7690.0]);
+        let start = game.state.position;
+        let mut ladder_ticks = 0;
+        for _ in 0..20 {
+            game.step(Cmd { forward: 400.0, yaw: 0.0, pitch: 0.0, ..Default::default() }).unwrap();
+            ladder_ticks += usize::from(game.state.mode == playsrc_movement::Mode::Ladder);
+        }
+        eprintln!("v{version}: {start:?} -> {:?}, ladder ticks {ladder_ticks}", game.state.position);
+        if version == PHYSICS_V18 {
+            assert!(ladder_ticks > 10, "attach to the reported ladder");
+            assert!(game.state.position[2] > start[2] + 25.0, "climb the ladder");
+        } else {
+            assert_eq!(ladder_ticks, 0, "old replays keep the original behavior");
+        }
+    }
+}
diff --git a/crates/core/tests/native_render.rs b/crates/core/tests/native_render.rs
new file mode 100644
index 0000000..1e17e37
--- /dev/null
+++ b/crates/core/tests/native_render.rs
@@ -0,0 +1,28 @@
+use bunnyhop_core::materials::{self, Kind};
+use bunnyhop_core::{content, mesh, vfs};
+use std::path::PathBuf;
+
+fn map_bytes(name: &str) -> Option<Vec<u8>> {
+    let path = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../maps").join(format!("{name}.bsp"));
+    std::fs::read(&path).map_err(|_| eprintln!("skipping {name}: {} not found", path.display())).ok()
+}
+
+/// GothQueen's unreal_space report: toolsblack is a visible opaque wall, not a nodraw tool.
+#[test]
+fn black_tool_walls_are_rendered() {
+    assert!(!mesh::hidden_tool_material("tools/toolsblack"));
+    assert!(!mesh::hidden_tool_material("tools/toolswhite"));
+    assert!(mesh::hidden_tool_material("tools/toolsnodraw"));
+    assert!(mesh::hidden_tool_material("tools/toolsplayerclip"));
+    let Some(bytes) = map_bytes("bhop_unreal_space") else { return };
+    let bsp = bunnyhop_core::parse_bsp(&bytes).unwrap();
+    let m = mesh::build(&bsp);
+    let material = m.materials.iter().position(|m| m.name == "tools/toolsblack").expect("map uses black walls");
+    let count: u32 = m.groups.iter().filter(|g| g.material as usize == material).map(|g| g.index_count).sum();
+    assert!(count > 0, "black wall faces must reach the renderer");
+    let mut fs = vfs::Vfs::default();
+    fs.mount(vfs::Source::from_zip("pak", content::pakfile(&bsp)));
+    let mats = materials::resolve(&fs, &["tools/toolsblack".into()]);
+    assert_eq!(mats.descs[0].kind, Kind::Textured);
+    assert_eq!(mats.descs[0].flags & (materials::FLAG_TRANSLUCENT | materials::FLAG_ADDITIVE), 0);
+}
